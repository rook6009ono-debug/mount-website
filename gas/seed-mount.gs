/**
 * 株式会社マウント 専用: 初期データ投入スクリプト
 *
 * 使い方:
 *   initialSetup を実行した後に、この seedMount を1回実行する。
 *   （再実行しても重複はしない。会社情報は上書き保存、追加項目は最新の内容に置き換わる）
 */
function seedMount() {
  // ---- 会社情報（company_master）----
  apiSaveCompany({
    company_name: '株式会社マウント',
    company_name_kana: 'かぶしきがいしゃまうんと',
    representative_name: '仲 隆宏',
    postal_code: '190-0034',
    address: '東京都立川市西砂町2-51-10 2F',
    tel: '042-569-6960',
    fax: '042-569-6961',
    email: 'info@mount-cp.com',
    // 設立日を入れるとHPの表記が「2007/03/19」形式になる。
    // 空のままなら、HPは現行の「平成19年3月19日」表記を維持する。
    established_date: '',
    capital: '1億円',
    employees: '45名',
    business_description: '大規模修繕工事、補助金工事取扱い、建物調査診断、防水工事、電気工事、設備工事、塗装工事、外壁補修工事、シーリング工事、仮設工事、内装工事、その他工事全般',
    website_url: 'https://mount-inc.com/',
    instagram_url: 'https://www.instagram.com/mount_tachikawa/',
    facebook_url: 'https://www.facebook.com/mount.tachikawa/'
  });

  // ---- 会社概要 追加項目（site_settings）----
  apiSaveSettings([
    { label: '北関東営業所', value: '〒373-0851 群馬県太田市飯田町612 レジデンス幸501号室\nTEL 0276-55-4961 ／ FAX 0276-55-4962' },
    { label: '建設業許可', value: '国土交通大臣 許可（特-8）第29911号\n建築工事業、大工工事業、左官工事業、とび・土工工事業、石工事業、屋根工事業、タイル・れんが・ブロック工事業、鋼構造物工事業、鉄筋工事業、板金工事業、ガラス工事業、塗装工事業、防水工事業、内装仕上工事業、熱絶縁工事業、建具工事業、解体工事業\n\n国土交通大臣 許可（般-8）第29911号\n電気工事業、管工事業' },
    { label: '産業廃棄物収集運搬業許可', value: '対象エリア：東京都、埼玉県、神奈川県、山梨県' },
    { label: '保有資格', value: '1級建築士、1級施工管理技士、2級施工管理技士、1級電気施工管理技士、2級管工事施工管理技士、マンション維持修繕技術者、1級ウレタン防水施工技能士、1級アスファルト防水施工技能士、1級塩化ビニル防水施工技能士、アスベスト調査者、その他業務等' },
    { label: '取引銀行', value: 'りそな銀行、多摩信用金庫、きらぼし銀行、東和銀行' },
    { label: '協力業者', value: '45社程度' },
    { label: '主要仕入先', value: '化研マテリアル株式会社／城北化研株式会社／シーカ・ジャパン株式会社／野口興産株式会社／株式会社K・Cアスカ／森商事株式会社／荻野化成株式会社／ニチハ株式会社／新明電材株式会社' },
    { label: '所属団体', value: '一般社団法人マンション計画修繕施工協会（MKS）／関東防水管理事業協同組合／ダイフレックス防水工事業協同組合／一般社団法人機能性外壁工業会／ハイブリットルーフ研究会／コニシべステム工業会／SDGsジャパン' }
  ]);

  // ---- 最初のお知らせ（公開状態で1件・再実行時は追加しない）----
  var seedTitle = 'ホームページをリニューアルしました';
  var exists = apiList('news').some(function (n) { return n.title === seedTitle; });
  if (!exists) {
    apiSaveItem('news', {
      title: seedTitle,
      body: 'この度、株式会社マウントのホームページをリニューアルいたしました。\n今後はこちらで、お知らせや施工情報を随時発信してまいります。',
      category: 'お知らせ',
      is_pinned: true,
      status: 'published',
      published_at: nowString_()
    });
  }

  seedMountRecruit();
  seedMountPhotos();
  seedMountTexts();

  Logger.log('マウント初期データの投入が完了しました');
}

/**
 * 説明文枠の初期登録（v3.6 文章編集機能）。
 * 再実行しても既存スロットはスキップされる（安全）。
 * 初期値は現在HPに載っている文章そのもの。管理画面「文章」から編集できる。
 */
function seedMountTexts() {
  apiSeedTextSlots([
    { slot: 'hero-copy', label: 'トップ：メインキャッチコピー',
      value: '地球環境への取り組み、修繕そして次世代へ。' },
    { slot: 'hero-sub', label: 'トップ：キャッチ下の説明文',
      value: '時と共に老朽化した建物へ、新たな息吹を。大規模修繕・防水・塗装から電気工事まで、確かな技術で建物と街の未来をつくります。' },
    { slot: 'top-about-title', label: 'トップ：会社紹介の見出し（【】で囲むと緑の強調）',
      value: '「私たちが少年の頃に建造された建物」に、\n【新たな息吹】を吹き込む。' },
    { slot: 'top-about-body', label: 'トップ：会社紹介の本文（空行で段落分け）',
      value: '弊社はこれまでの改修工事で培ってきた経験と知識を活かし、時と共に老朽化した建物を、時代のニーズに合わせ新しいものへと生まれ変わらせています。\n\n常にチャレンジ精神を忘れず、どんな時も「健全であり誠実であり続けること」に全身全霊を注ぐ。これこそが弊社の誇りです。' },
    { slot: 'biz-renovation-text', label: 'トップ：リノベーション工事カードの説明文',
      value: '建物の経年に伴う劣化や不具合にあわせて計画的に実施する修繕工事。調査診断から工法提案・施工・アフターフォローまで一貫対応し、居住者様が安心・快適に住み続けられる建物へ。' },
    { slot: 'biz-electric-text', label: 'トップ：電気事業カードの説明文',
      value: '漏電調査・修理、分電盤交換、道路照明工事、セキュリティ関連機器の設置、太陽光発電施設の設計・施工、交通信号工事など、幅広い電気関連サービスを提供しています。' },
    { slot: 'about-message-body', label: 'マウントについて：冒頭のメッセージ本文（空行で段落分け）',
      value: '既存の建築物に光を当て、よりよいものとしての快適な空間へ再生させる「リノベーション」や「リフォーム」。それは時間を経たものの持つ、独特のデザインや個性を活かしつつも、利便性や新しいデザインを取り入れ、新しい用途を持つ別の建物へと生まれ変わらせるだけでなく、既存のものとの調和を大事にし、次世代へと受け継がせてゆくことで、その建物の歴史を残すという重要なこと──弊社はそう考え、修復を施すことに重点を置きながらも、お客様の想像を超える豊かな発想をご提案させていただきます。\n\nお客様の個々のニーズに柔軟かつ幅広くお答えし、時間的・空間的に限界のない「住み続けたい家」へと、私たちの卓越した技術と経験でお応えします。過去を再生させるだけではなく、未来を見据えた、よりよい建築物の確かな豊かさを私たちはご提供いたします。' },
    { slot: 'greeting-body', label: 'マウントについて：代表挨拶の本文（空行で段落分け）',
      value: '弊社株式会社マウントは、防水工事を主体とする工事会社として平成19年に創業し、以降皆様のご支援、ご協力を経て現在はリニューアル工事全般の工事を行うことができるまでに成長することができました。\n\nこれからは、持続可能な社会の実現や環境問題への配慮も私たちの重要な責任であると考えております。\n\n会社のスローガンである「修繕そして次世代に」という言葉通りにお客様とそのご子息が安心して暮していけるように、建物だけでなく環境も次世代へつなげていけるよう社員一丸となって取り組んでまいります。' },
    { slot: 'electric-lead', label: '電気事業：冒頭の紹介文',
      value: '2024年の電気事業部発足以来、漏電調査・修理から交通信号工事まで、暮らしと街のインフラを支える電気関連サービスを幅広く手掛けています。' },
    { slot: 'recruit-message-title', label: '採用情報：メッセージ見出し（【】で囲むと緑の強調）',
      value: '経験よりも、やる気。\n手に職をつけて、【次世代に残る仕事】を。' },
    { slot: 'recruit-message-body', label: '採用情報：メッセージ本文（空行で段落分け）',
      value: 'マウントの仕事は、時を経た建物に新たな息吹を吹き込み、次の世代へつなぐこと。あなたが手がけた建物は、この街に何十年も残り続けます。\n\n未経験からのスタート大歓迎。資格取得は会社が全力でバックアップし、エネルギッシュな30代の先輩たちが、現場でゼロから教えます。' },
    { slot: 'contact-lead', label: 'お問い合わせ：冒頭の案内文',
      value: '改修工事のご依頼・ご相談・お見積り、採用へのご応募はこちらから。\n以下のフォームをご記入いただき、内容をご確認の上、送信ボタンを押してください。' }
  ]);
  Logger.log('説明文枠の初期登録が完了しました');
}

